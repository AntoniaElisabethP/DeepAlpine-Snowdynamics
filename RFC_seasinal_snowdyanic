import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np

# 1. Daten laden
df_res = pd.read_csv(ergebnis_pfad, sep=';', on_bad_lines='skip')
df_res.columns = df_res.columns.str.strip()
col_date = [c for c in df_res.columns if 'dat' in c.lower()][0]
col_snow = [c for c in df_res.columns if 'schnee' in c.lower()][0]

# 2. Zeitliche Aufbereitung ( Reihenfolge einhalten)
df_res['Datum_Clean'] = pd.to_datetime(df_res[col_date], dayfirst=True)
df_res['Monat'] = df_res['Datum_Clean'].dt.month
df_res['Jahr'] = df_res['Datum_Clean'].dt.year
# Hier erstellen wir die fehlende Spalte 'Jahrzehnt'
df_res['Jahrzehnt'] = (df_res['Jahr'] // 10) * 10

# 3. Filtern: Nur volle Jahrzehnte bis 2019 (keine 2020er)
df_plot = df_res[df_res['Jahrzehnt'].isin([1990, 2000, 2010])].copy()

# 4. Fokus auf die relevante Schneesaison (Okt - Mai)
winter_months = [10, 11, 12, 1, 2, 3, 4, 5]
df_winter = df_plot[df_plot['Monat'].isin(winter_months)].copy()

# --- VISUALISIERUNG ---
plt.figure(figsize=(12, 7))

# errorbar=None entfernt die Schatten/Standardabweichungen
sns.lineplot(data=df_winter, x='Monat', y=col_snow, hue='Jahrzehnt', 
             palette='viridis', marker='o', linewidth=2.5, errorbar=None)

# Optik für die Diplomarbeit
plt.gca().invert_yaxis() # Gipfel oben
plt.xticks(winter_months, ['Okt', 'Nov', 'Dez', 'Jan', 'Feb', 'Mär', 'Apr', 'Mai'])

plt.title('Saisonale Verschiebung der Schneegrenze im Ötztal\nVergleich der Dekaden 1990-2019', fontsize=14)
plt.ylabel('Höhe der Schneegrenze [m ü.M.]', fontsize=12)
plt.xlabel('Monat', fontsize=12)

plt.grid(True, linestyle='--', alpha=0.5)
# Beschriftung der Legende
plt.legend(title='Dekade', labels=['1990er', '2000er', '2010er'], loc='upper left')

plt.tight_layout()
plt.show()

# --- ZUSATZ: STATISTIK FÜR DEN TEXT ---
stats = df_winter.groupby(['Jahrzehnt', 'Monat'])[col_snow].mean().unstack()
print("\n--- Mittlere Schneegrenzhöhen pro Monat und Dekade ---")
print(stats)
